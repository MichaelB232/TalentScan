# ─────────────────────────────────────────────────────────────
# Root .env for docker-compose
# Copy this to .env and fill in your values.
# DO NOT commit the filled-in .env to version control.
# ─────────────────────────────────────────────────────────────

# PostgreSQL credentials
POSTGRES_USER=talentscan
POSTGRES_PASSWORD=changeme_supersecret
POSTGRES_DB=talentscan_db

# Google Gemini API key  (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Port the frontend will be exposed on (default: 80)
FRONTEND_PORT=80
